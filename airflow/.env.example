# Copia este archivo a .env (que no se sube a git) y ajusta los valores.
# Aquí no van llaves de AWS: Airflow usa tu sesión de `aws login` montada desde ~/.aws.

# Tu usuario de Linux, para que los logs queden a tu nombre. Sácalo con: id -u
AIRFLOW_UID=1000

# Secreto con el que los componentes de Airflow firman sus tokens internos.
# Genera uno con: openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# Destino del extractor y tema de SNS para avisos de falla (salidas de Terraform).
SECOP_LAGO=s3://secop-risk-lake-716528269015/raw
SECOP_ALERTAS_SNS=arn:aws:sns:us-east-2:716528269015:secop-risk-alertas
